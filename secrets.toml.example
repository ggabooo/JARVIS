# En Community Cloud pega el contenido en Settings > Secrets.
# Local: copia este archivo a .streamlit/secrets.toml y completa los valores.
GROQ_API_KEY = "TU_CLAVE_GROQ"
GROQ_MODEL = "openai/gpt-oss-120b"

# Opcional: persistencia en Supabase, después de ejecutar sql/supabase_sessions.sql.
# SUPABASE_URL = "https://TU_PROYECTO.supabase.co"
# SUPABASE_KEY = "TU_CLAVE_SECRET_DE_BACKEND"

# Opcional: protege el acceso a la web con una contraseña compartida.
# No crea cuentas individuales ni recuperación de contraseña.
# APP_PASSWORD = "ELIGE_UNA_CONTRASENA_LARGA"
